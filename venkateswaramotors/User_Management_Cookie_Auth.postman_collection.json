{
	"info": {
		"_postman_id": "vm-user-management-cookie-auth",
		"name": "Venkateswara Motors - User Management (Cookie Auth)",
		"description": "API collection for testing User Management with cookie-based authentication. This collection works with the existing OTP-based login system.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication Setup",
			"item": [
				{
					"name": "1. Login (Send OTP)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@venkateswaramotors.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/service-center/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"auth",
								"login"
							]
						},
						"description": "Step 1: Send OTP to admin email for login"
					},
					"response": []
				},
				{
					"name": "2. Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@venkateswaramotors.com\",\n  \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/service-center/auth/verify-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"auth",
								"verify-otp"
							]
						},
						"description": "Step 2: Verify OTP to get authentication cookies. Check the response cookies - you should see vm_auth_token and vm_user_email cookies."
					},
					"response": []
				},
				{
					"name": "3. Test Authentication",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/test-auth",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"test-auth"
							]
						},
						"description": "Test if authentication is working. This should return 'Authentication successful!' if you're logged in as admin."
					},
					"response": []
				}
			],
			"description": "Steps to authenticate and test the user management system"
		},
		{
			"name": "User Management Operations",
			"item": [
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"technician@venkateswaramotors.com\",\n  \"firstName\": \"Rajesh\",\n  \"lastName\": \"Kumar\",\n  \"phoneNumber\": \"9876543210\",\n  \"address\": \"123 Service Center Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\",\n  \"role\": \"USER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users"
							]
						},
						"description": "Create a new user with USER role. Make sure you're authenticated as admin first."
					},
					"response": []
				},
				{
					"name": "Create Admin User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin2@venkateswaramotors.com\",\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Sharma\",\n  \"phoneNumber\": \"9876543211\",\n  \"address\": \"456 Admin Street\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400002\",\n  \"role\": \"ADMIN\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users"
							]
						},
						"description": "Create a new admin user with ADMIN role."
					},
					"response": []
				},
				{
					"name": "Get All Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users?page=0&size=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								}
							]
						},
						"description": "Get all users with pagination. Default page size is 10."
					},
					"response": []
				},
				{
					"name": "Get Users by Role",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users?role=USER&page=0&size=20",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users"
							],
							"query": [
								{
									"key": "role",
									"value": "USER"
								},
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "20"
								}
							]
						},
						"description": "Get all users filtered by role (USER or ADMIN)."
					},
					"response": []
				},
				{
					"name": "Search Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users?search=rajesh&page=0&size=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users"
							],
							"query": [
								{
									"key": "search",
									"value": "rajesh"
								},
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								}
							]
						},
						"description": "Search users by email, firstName, lastName, or phoneNumber."
					},
					"response": []
				},
				{
					"name": "Get User Statistics",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/stats",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"stats"
							]
						},
						"description": "Get user statistics including total users, admin users, regular users, enabled users, and locked users."
					},
					"response": []
				}
			],
			"description": "Core user management operations"
		},
		{
			"name": "Individual User Operations",
			"item": [
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}"
							]
						},
						"description": "Get a specific user by their ID. Set user_id variable from create response."
					},
					"response": []
				},
				{
					"name": "Get User by Email",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/email/technician@venkateswaramotors.com",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"email",
								"technician@venkateswaramotors.com"
							]
						},
						"description": "Get a specific user by their email address."
					},
					"response": []
				},
				{
					"name": "Update User",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"firstName\": \"Updated Rajesh\",\n  \"lastName\": \"Updated Kumar\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"enabled\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}"
							]
						},
						"description": "Update user information. Only provided fields will be updated."
					},
					"response": []
				},
				{
					"name": "Change User Role",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}/role?role=ADMIN",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}",
								"role"
							],
							"query": [
								{
									"key": "role",
									"value": "ADMIN"
								}
							]
						},
						"description": "Change user role from USER to ADMIN or vice versa."
					},
					"response": []
				},
				{
					"name": "Enable User Account",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}/status?enabled=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}",
								"status"
							],
							"query": [
								{
									"key": "enabled",
									"value": "true"
								}
							]
						},
						"description": "Enable a user account so they can access the system."
					},
					"response": []
				},
				{
					"name": "Disable User Account",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}/status?enabled=false",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}",
								"status"
							],
							"query": [
								{
									"key": "enabled",
									"value": "false"
								}
							]
						},
						"description": "Disable a user account to prevent access to the system."
					},
					"response": []
				},
				{
					"name": "Lock User Account",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}/lock?locked=true",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}",
								"lock"
							],
							"query": [
								{
									"key": "locked",
									"value": "true"
								}
							]
						},
						"description": "Lock a user account to temporarily prevent access."
					},
					"response": []
				},
				{
					"name": "Unlock User Account",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}/lock?locked=false",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}",
								"lock"
							],
							"query": [
								{
									"key": "locked",
									"value": "false"
								}
							]
						},
						"description": "Unlock a previously locked user account."
					},
					"response": []
				},
				{
					"name": "Delete User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/service-center/user-management/users/{{user_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"service-center",
								"user-management",
								"users",
								"{{user_id}}"
							]
						},
						"description": "Permanently delete a user from the system. This action cannot be undone."
					},
					"response": []
				}
			],
			"description": "Operations on individual users"
		},
